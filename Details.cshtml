
@using EduTrack.Models
@model Classroom

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <p class="text-muted mb-0">
            Manage students in this class.
        </p>
    </div>

    <a class="btn btn-success"
       asp-controller="Attendance"
       asp-action="Mark"
       asp-route-classId="@Model.Id">
        Take Attendance
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form method="post" asp-action="AddStudent" class="row g-2 mb-4">
    <input type="hidden" name="classId" value="@Model.Id" />

    <div class="col-md-3">
        <input name="rollNumber"
               class="form-control"
               placeholder="Roll number"
               required />
    </div>

    <div class="col-md-3">
        <input name="firstName"
               class="form-control"
               placeholder="First name"
               required />
    </div>

    <div class="col-md-3">
        <input name="lastName"
               class="form-control"
               placeholder="Last name" />
    </div>

    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-person-plus me-1"></i> Add Student
        </button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Roll No</th>
                <th>Name</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var s in Model.Students)
            {
                <tr>
                    <td>@s.RollNumber</td>
                    <td>@s.FullName</td>
                    <td class="text-end">
                        <form method="post"
                              asp-action="DeleteStudent"
                              onsubmit="return confirm('Are you sure you want to delete this student?');">
                            <input type="hidden" name="studentId" value="@s.Id" />
                            <input type="hidden" name="classId" value="@Model.Id" />

                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i> Back to Classes
</a>
