
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduTrack</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid px-3 px-lg-4">

                <a class="navbar-brand app-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>
                    <span>Edu<span class="brand-highlight">Track</span></span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <partial name="_LoginPartial" />
                    </div>
                </div>

            </div>
        </nav>
    </header>

    @{
        var isLoginPage =
            string.Equals(
                ViewContext.RouteData.Values["controller"]?.ToString(),
                "Account",
                StringComparison.OrdinalIgnoreCase)
            &&
            string.Equals(
                ViewContext.RouteData.Values["action"]?.ToString(),
                "Login",
                StringComparison.OrdinalIgnoreCase);
    }

    <div class="app-shell @(isLoginPage ? "login-only" : "")">

        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="app-sidebar">
                <div class="sidebar-heading">MAIN MENU</div>

                <nav class="sidebar-nav">
                    <a class="sidebar-link"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>

                    <a class="sidebar-link"
                       asp-controller="Classes"
                       asp-action="Index">
                        <i class="bi bi-people-fill"></i>
                        <span>Classes</span>
                    </a>

                    <a class="sidebar-link"
                       asp-controller="Events"
                       asp-action="Index">
                        <i class="bi bi-calendar-event-fill"></i>
                        <span>Events</span>
                    </a>
                </nav>

                <div class="sidebar-footer">
                    <div class="sidebar-footer-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <div class="sidebar-footer-title">EduTrack</div>
                        <div class="sidebar-footer-subtitle">
                            Attendance Management
                        </div>
                    </div>
                </div>
            </aside>
        }

        <main class="app-main @(User.Identity?.IsAuthenticated == true ? "with-sidebar" : "public-main")">

            <div class="page-content">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="page-topline">
                        <div>
                            <div class="page-eyebrow">EDUTRACK WORKSPACE</div>
                            <h1 class="page-heading">
                                @(ViewData["Title"] ?? "Dashboard")
                            </h1>
                        </div>

                        <div class="page-date">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Attendance & Events</span>
                        </div>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show"
                         role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["ErrorMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close"></button>
                    </div>
                }

                @RenderBody()

            </div>

            <footer class="app-footer">
                <span>&copy; @DateTime.Now.Year EduTrack</span>
                <span>Digital Attendance & Event Management</span>
            </footer>

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
